  m_Name: 
  m_EditorClassIdentifier: Unity.TextMeshPro::TMPro.TextMeshProUGUI
  m_Material: {fileID: 0}
  m_Color: {r: 1, g: 1, b: 1, a: 1}
  m_RaycastTarget: 1
  m_RaycastPadding: {x: 0, y: 0, z: 0, w: 0}
  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: 'First off, if any intel from the field mentions Duty to Inform, you must
    check FIVE things!


    1: Who is the data controller?

    That''s US, we''re
    receiving and using the intel!


    2: What is the purpose of data processing?

    To
    defeat our enemies!


